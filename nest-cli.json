{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/lab-project/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/lab-project/tsconfig.app.json",
    "webpackConfigPath": "webpack.config.js"
  },
  "monorepo": true,
  "root": "apps/lab-project",
  "projects": {
    "lab-project": {
      "type": "application",
      "root": "apps/lab-project",
      "entryFile": "main",
      "sourceRoot": "apps/lab-project/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lab-project/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "webpack.config.js"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    }
  }
}
